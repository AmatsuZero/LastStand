filters:
  and:
    - file.inFolder("Notes")
    - file.ext == "md"
    - file.name != "README"
views:
  - type: table
    name: 全部笔记
    order:
      - title
      - status
      - topics
      - source_notes
      - created
    sort:
      - property: created
        direction: DESC
  - type: cards
    name: 按状态复习
    order:
      - title
      - status
      - topics
